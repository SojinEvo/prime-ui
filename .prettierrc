{
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100,
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "overrides": [
        {
            "files": [
                "*.less"
            ],
            "options": {
                "parser": "less"
            }
        }
    ]
}